---
import AsciiField from "@rinci/brand/astro/AsciiField.astro"
import PixelLogo from "@rinci/brand/astro/PixelLogo.astro"
import Footer from "../components/Footer.astro"
import Header from "../components/Header.astro"
import ProviderPicker from "../components/ProviderPicker.astro"
import Base from "../layouts/Base.astro"
import { getCatalog } from "../lib/catalog"
import { site } from "../site"

const providers = await getCatalog()
const builtIn = providers.filter((p) => p.name !== "exec")

const principles = [
  {
    title: "Credentials stay out of the config",
    body: "The config says where secrets live, so it can be committed. Logins come from the environment or an untracked env file. A key that looks like a credential is rejected.",
  },
  {
    title: "Your app gets secrets, not the identity",
    body: "The token that fetched the secrets is removed from your command's environment, so a compromised dependency cannot use it to read everything else.",
  },
  {
    title: "Fails closed",
    body: "If a source fails, the command does not start. No app booting half-configured against the wrong database.",
  },
  {
    title: "No shell in between",
    body: "Arguments reach the program exactly as typed, Windows .cmd shims included. A quote or an & in a value cannot become a second command.",
  },
  {
    title: "HTTPS, or a private network",
    body: "Plain HTTP is refused unless the host is local or private, like an in-cluster API reached over WARP or a VPN.",
  },
  {
    title: "Short-lived and in memory",
    body: "Tokens minted for a run are revoked when the read is done. Values are never written to disk or printed in logs.",
  },
]

const platforms = ["macOS", "Linux", "Windows", "Bun", "Node 20.10+"]
---

<Base>
  <Header />

  <main id="content">
    <section
      class="relative isolate flex flex-col items-center overflow-hidden border-b border-line px-5 pt-24 pb-20 text-center sm:px-8 md:pt-32 md:pb-24"
    >
      <div class="ascii-backdrop absolute inset-0 -z-10" aria-hidden="true">
        <AsciiField />
      </div>

      <div class="w-10 sm:w-12">
        <PixelLogo mark />
      </div>
      <p class="pixel-type brand-in mt-8 text-[12px] text-signal [--brand-delay:500ms]" data-scramble>
        {site.packageName}
      </p>
      <h1
        class="brand-in mt-5 max-w-[17ch] text-[34px] leading-[1.04] font-medium tracking-tight text-balance [--brand-delay:620ms] sm:text-[46px] md:text-[58px]"
      >
        Every secrets manager. One command.
      </h1>
      <p
        class="brand-in mt-6 max-w-[50ch] text-[15px] leading-relaxed text-dim [--brand-delay:740ms] md:text-[16px]"
      >
        Pull secrets from Infisical, Doppler, Vault, AWS, Google Cloud, Azure, 1Password, Bitwarden, SOPS or any CLI,
        and start your command with them in its environment. One config, zero dependencies, nothing written to disk.
      </p>

      <div class="brand-in mt-9 flex w-full max-w-md flex-col gap-3 [--brand-delay:860ms] sm:flex-row">
        <div class="code-frame min-w-0 flex-1 text-left">
          <pre
            class="astro-code border-line bg-ink-2 !py-3.5 text-[13px]"><code><span class="text-faint">$ </span>bun add -d {site.packageName}</code></pre>
        </div>
        <a
          href="#setup"
          data-scramble
          class="pixel-type inline-flex items-center justify-center bg-paper px-6 py-3.5 text-[12px] text-ink transition-transform duration-150 hover:bg-signal active:translate-y-px"
        >
          Set it up
        </a>
      </div>
      <ul class="brand-in mt-8 flex flex-wrap justify-center gap-x-5 gap-y-2 text-[12.5px] text-faint [--brand-delay:960ms]">
        {platforms.map((platform) => <li>{platform}</li>)}
      </ul>
    </section>

    <section id="setup" class="scroll-mt-14 border-b border-line">
      <div class="mx-auto w-full max-w-6xl px-5 py-20 sm:px-8 md:py-24">
        <div class="max-w-[60ch]">
          <h2 class="text-[28px] leading-tight font-medium tracking-tight md:text-[36px]">Set up in a minute.</h2>
          <p class="mt-4 text-[15px] leading-relaxed text-dim">
            Pick the secrets manager you use. These are the exact commands and the config the CLI writes for it.
          </p>
        </div>
        <div class="mt-10">
          <ProviderPicker providers={providers} />
        </div>
      </div>
    </section>

    <!-- What a run looks like. Static on purpose: the real output, not an animation of it. -->
    <section class="border-b border-line bg-ink-2">
      <div class="mx-auto grid w-full max-w-6xl gap-12 px-5 py-20 sm:px-8 md:grid-cols-[1fr_1.2fr] md:items-center md:py-24">
        <div class="reveal">
          <h2 class="max-w-[16ch] text-[28px] leading-tight font-medium tracking-tight md:text-[36px]">
            Wrap the command you already run.
          </h2>
          <p class="mt-5 max-w-[44ch] text-[15px] leading-relaxed text-dim">
            Sources are read in parallel and merged in order, so a local <code class="font-mono text-paper">.env</code>
            can sit on top of a shared one. Every run says where its values came from and which variables it replaced.
            Never the values themselves.
          </p>
        </div>
        <div class="reveal min-w-0 border border-line bg-ink font-mono text-[12.5px] leading-[1.9] sm:text-[13px]">
          <div class="flex items-center gap-1.5 border-b border-line px-4 py-2.5" aria-hidden="true">
            <span class="size-1.5 bg-line"></span><span class="size-1.5 bg-line"></span><span class="size-1.5 bg-signal"
            ></span>
          </div>
          <pre class="overflow-x-auto px-4 py-4"><code><span class="text-faint">$</span> <span class="text-paper">rsec run -e prod -- bun start</span>
<span class="text-signal">secrets</span> <span class="text-dim">42 secrets from infisical 38 (184ms), dotenv 4 (1ms)</span>
<span class="text-signal">secrets</span> <span class="text-dim">overriding 1 existing: NODE_ENV</span>
<span class="text-paper">  ready on http://localhost:3000</span></code></pre>
        </div>
      </div>
    </section>

    <section class="border-b border-line">
      <div class="mx-auto w-full max-w-6xl px-5 py-20 sm:px-8 md:py-24">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <h2 class="reveal max-w-[20ch] text-[28px] leading-tight font-medium tracking-tight md:text-[36px]">
              {builtIn.length} providers built in. Anything else through its CLI.
            </h2>
          </div>
          <a href="/docs/providers" class="reveal shrink-0 text-[13px] text-dim transition-colors hover:text-paper">
            Compare providers →
          </a>
        </div>
        <ul class="mt-12 grid border-t border-l border-line sm:grid-cols-2 lg:grid-cols-3">
          {
            providers.map((provider) => (
              <li class="border-r border-b border-line">
                <a href={provider.href} class="group flex h-full flex-col p-6 transition-colors hover:bg-ink-2">
                  <span class="flex items-baseline justify-between gap-3">
                    <span class="pixel-type text-[12px] text-paper transition-colors group-hover:text-signal">
                      {provider.label}
                    </span>
                    <code class="font-mono text-[11.5px] text-faint">{provider.name}</code>
                  </span>
                  <p class="mt-3 text-[13.5px] leading-relaxed text-dim">{provider.summary}</p>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="border-b border-line bg-ink-2">
      <div class="mx-auto w-full max-w-6xl px-5 py-20 sm:px-8 md:py-24">
        <h2 class="reveal max-w-[18ch] text-[28px] leading-tight font-medium tracking-tight md:text-[36px]">
          Safe by default, readable throughout.
        </h2>
        <p class="reveal mt-5 max-w-[56ch] text-[15px] leading-relaxed text-dim">
          No dependencies sit between your credentials and the network. Request signing, token exchange and process
          spawning are a few hundred lines each, in the repository, tested on macOS, Linux and Windows.
        </p>
        <div class="mt-14 grid gap-x-12 md:grid-cols-2">
          {
            principles.map((item) => (
              <article class="reveal border-t border-line py-7">
                <h3 class="flex items-center gap-3 text-[15px] font-medium text-paper">
                  <span class="size-1.5 shrink-0 bg-signal" aria-hidden="true" />
                  {item.title}
                </h3>
                <p class="mt-2 max-w-[52ch] pl-[18px] text-[14px] leading-relaxed text-dim">{item.body}</p>
              </article>
            ))
          }
        </div>
        <a
          href="/docs/security"
          class="reveal mt-4 inline-block text-[13px] text-dim transition-colors hover:text-paper"
        >
          Read the security model →
        </a>
      </div>
    </section>

    <section class="px-5 py-24 text-center sm:px-8 md:py-28">
      <div class="mx-auto w-full max-w-2xl">
        <h2 class="reveal text-[28px] leading-[1.08] font-medium tracking-tight text-balance md:text-[40px]">
          Replace the script you keep copying between repos.
        </h2>
        <p class="reveal mx-auto mt-5 max-w-[44ch] text-[15px] leading-relaxed text-dim">
          Start with the provider you use today. Add a second source when you need one; the command stays the same.
        </p>
        <div class="reveal mt-9 flex flex-wrap justify-center gap-3">
          <a
            href="/docs"
            data-scramble
            class="pixel-type inline-block bg-paper px-6 py-3.5 text-[12px] text-ink transition-transform duration-150 hover:bg-signal active:translate-y-px"
          >
            Get started
          </a>
          <a
            href="/docs/migrating"
            class="pixel-type inline-block border border-line px-6 py-3.5 text-[12px] text-paper transition-colors duration-150 hover:border-signal hover:text-signal"
          >
            Migrate a script
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
