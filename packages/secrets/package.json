{
  "name": "@rinci/secrets",
  "version": "0.1.0",
  "description": "One entry point for every secrets manager. Fetch from Infisical, Doppler, Vault, AWS, GCP, Azure, 1Password, Bitwarden or .env files and run any command with them injected.",
  "keywords": [
    "1password",
    "aws-secrets-manager",
    "azure-key-vault",
    "bitwarden",
    "bun",
    "cli",
    "doppler",
    "dotenv",
    "env",
    "gcp-secret-manager",
    "infisical",
    "secrets",
    "vault"
  ],
  "homepage": "https://secrets.rin.ci",
  "license": "MIT",
  "author": "Rafa Al Razzak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rinci-labs/secrets.git",
    "directory": "packages/secrets"
  },
  "bin": {
    "rinci-secrets": "./dist/cli.js",
    "rsec": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "schema.json"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.10"
  }
}
